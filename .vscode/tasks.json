{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run: Python (local)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/litestar --app main:app run --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true
    },
    {
      "label": "Docker: Build",
      "type": "shell",
      "command": "docker build -t rov-trail-widget .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: Run",
      "type": "shell",
      "command": "docker run --rm -p 8000:8000 rov-trail-widget",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: Build & Run",
      "type": "shell",
      "command": "docker build -t rov-trail-widget . && docker run --rm -p 8000:8000 rov-trail-widget",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
